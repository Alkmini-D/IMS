@page "/addassembly"
@using IMS_WebApp.Controls 
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IAddAssemblyUseCase AddAssemblyUseCase
@inject NavigationManager NavigationManager


<h3>Add Assembly</h3>
<br/>
@if (this.assembly != null)
{
    <EditForm Model="assembly" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <div class="form-group">
            <label for="name">Product Name</label>
            <InputText id="name" @bind-Value="assembly.AssemblyName" class="form-control"></InputText>
        </div>

        <div class="form-group">
            <label for="qty">Quantity</label>
            <InputNumber id="qty" @bind-Value="assembly.Quantity" class="form-control"></InputNumber>
        </div>

        <div class="form-group">
            <label for="price">Price</label>
            <InputNumber id="price" @bind-Value="assembly.Price" class="form-control"></InputNumber>
        </div>

        <AssemblyInventoriesComponent 
            @ref="AssemblyInventoriesComponent"
            OnInventorySelected="OnInventorySelected"
        ></AssemblyInventoriesComponent>

        <br/>
        <button type="submit" class="btn btn-primary">Save</button>

    </EditForm>
}


@code {

    private Assembly? assembly;
    private AssemblyInventoriesComponent AssemblyInventoriesComponent;

    protected override void OnInitialized()
    {
        this.assembly = new Assembly();
    }

    private async Task OnValidSubmit()
    {
        if (this.assembly != null)
        {
            this.AssemblyInventoriesComponent.AssemblyInventories.ForEach(x =>
            {
                x.AssemblyId = this.assembly.AssemblyId;
            });
            //this.product.ProductInventories = this.ProductInventoriesComponent.ProductInventories;

            await AddAssemblyUseCase.ExecuteAsync(this.assembly);
            NavigationManager.NavigateTo("/assemblies");
        }
    }    

    private void OnInventorySelected(List<AssemblyInventory> assemblyInventories)
    {
        this.assembly.AssemblyInventories = assemblyInventories;
    }
}
