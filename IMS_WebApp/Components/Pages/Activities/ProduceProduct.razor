@page "/produce"
@using IMS.WebApp.ViewModels
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IProduceAssemblyUseCase ProduceAssemblyUseCase
@inject IValidateEnoughInventoriesForProducingUseCase ValidateEnoughInventoriesForProducingUseCase

<ErrorMessageComponent ErrorMessage="@errorMessage"></ErrorMessageComponent>
<h3>Produce Assembly</h3>
<br/>
@if (produceViewModel != null)
{
    <EditForm Model="produceViewModel" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <div class="form-group">
            <label for="po">Production Number</label>
            <InputText id="po" @bind-Value="produceViewModel.ProductionNumber" class="form-control"></InputText>
        </div>

        <div class="form-group">
            <label for="inv">Assembly to Produce</label>
            <ViewAssembliesComponent 
                OnSelectAssembly="OnSelectAssembly"
                DisplaySearchResult="true"></ViewAssembliesComponent>                   
            <InputText id="inv" class="form-control" @bind-Value="produceViewModel.AssemblyName" disabled></InputText>            
            <input type="hidden" value="@produceViewModel.AssemblyId" />  
            @if (selectedAssembly != null)
            {
                <div style="margin-top:3px">
                    <text>Price:</text>
                    @selectedAssembly?.Price.ToString("c")
                </div>                
            }
            
        </div>

        <div class="form-group">
            <label for="qty">Quantity</label>
            <InputNumber id="qty" @bind-Value="produceViewModel.QuantityToProduce" class="form-control"></InputNumber>
        </div>
        <br/>
        <button type="submit" class="btn btn-primary">Produce</button>

    </EditForm>
}

@code {
    private ProduceViewModel produceViewModel = new ProduceViewModel();
    private Assembly selectedAssembly;
    private string errorMessage;

    private async Task OnValidSubmit()
    {
        if (!await ValidateEnoughInventoriesForProducingUseCase.ExecuteAsync(this.selectedAssembly, this.produceViewModel.QuantityToProduce))
        {
            //we need to show an error message here
            errorMessage = $"The inventories are not enough for producing {this.selectedAssembly.AssemblyName} X {this.produceViewModel.QuantityToProduce} times";

            return;
        }
        else
        {
            errorMessage = string.Empty;
        }

        await ProduceAssemblyUseCase.ExecuteAsync(
            this.produceViewModel.ProductionNumber,
            this.selectedAssembly,
            this.produceViewModel.QuantityToProduce,
            "User"
        );

        this.produceViewModel = new ProduceViewModel();
        this.selectedAssembly = null;
        this.errorMessage = string.Empty;
    }

    public void OnSelectAssembly(Assembly assembly)
    {
        this.selectedAssembly = assembly;
        produceViewModel.AssemblyId = assembly.AssemblyId;
        produceViewModel.AssemblyName = assembly.AssemblyName;
    }

}

